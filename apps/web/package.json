{
	"name": "web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:mobile": "vite build --mode mobile",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"dependencies": {
		"@capacitor/core": "^8.6.2",
		"@capacitor/local-notifications": "^8.3.1",
		"@hugeicons/core-free-icons": "^4.4.0",
		"@lumia/core": "workspace:*",
		"@lumia/ui": "workspace:*",
		"bits-ui": "^2.21.0",
		"clsx": "^2.1.1",
		"mermaid": "^12.3.0",
		"qrcode": "^1.5.4",
		"tailwind-merge": "^3.7.1",
		"tailwind-variants": "^4.0.2",
		"temporal-polyfill": "^1.0.8"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.4",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.10",
		"@types/qrcode": "^1.5.6",
		"@vitest/coverage-v8": "^5.1.0",
		"fake-indexeddb": "^6.2.7",
		"jsdom": "^30.1.3",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	}
}
