{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["chrome", "vite/client"],
		"skipLibCheck": true,
		"noEmit": true,
		"verbatimModuleSyntax": true,
		"allowImportingTsExtensions": true,
		"paths": {
			"$technical/*": ["./technical/*"],
			"$domain/*": ["./domain/*"],
			"$test-support/*": ["./test-support/*"]
		}
	},
	"include": ["**/*.ts", "**/*.svelte"],
	"exclude": ["dist", "node_modules"]
}
