{
	"name": "extension",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"build": "pnpm build:chrome && pnpm build:firefox",
		"build:chrome": "EXTENSION_TARGET=chrome vite build",
		"build:firefox": "EXTENSION_TARGET=firefox vite build",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"check": "svelte-check --tsconfig ./tsconfig.json"
	},
	"dependencies": {
		"@hugeicons/core-free-icons": "^4.4.0",
		"@lumia/core": "workspace:*",
		"@lumia/ui": "workspace:*",
		"bits-ui": "^2.20.2",
		"clsx": "^2.1.1",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.8",
		"@types/chrome": "^0.1.40",
		"@vitest/coverage-v8": "^5.0.5",
		"jsdom": "^30.1.3",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.0.5"
	}
}
