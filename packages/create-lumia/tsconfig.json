{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"types": ["node"],
		"lib": ["ES2022"],
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": ["src/**/*.ts", "tsup.config.ts", "vitest.config.ts"]
}
