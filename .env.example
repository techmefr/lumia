POSTGRES_PASSWORD=change-me

# The admin account created at the first start, once the migrations have been applied. Left empty,
# the browser onboarding screen stays the way in; filled, the account is created once and a later
# restart neither creates a second one nor rewrites its password.
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Starting point for the instance quotas: how many accounts it accepts, and how much one account
# may store. The admin owns both numbers afterwards, from the administration panel.
MAX_ACCOUNTS=10
ACCOUNT_QUOTA_MB=1000

JWT_SECRET=change-me
SECRET_ENCRYPTION_KEY=change-me

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=change-me
SMTP_PASSWORD=change-me
SMTP_FROM_ADDRESS=noreply@example.com
# Used to build the clickable links in the magic-link and digest emails. Change it if the app is reached
# from a real domain or a LAN address rather than localhost.
FRONTEND_URL=http://localhost:8080

# The authentication routes are rate limited per address and per account. The web container's
# nginx sets X-Forwarded-For, so the API reads the caller's address from it. Set this to false if
# the API is exposed directly, otherwise a caller can pick their own address by sending the header.
TRUST_PROXY_HEADERS=true

# Address the API port (8000) is published on. Loopback by default: the web container reaches the
# API over the compose network, so only a client running on this machine needs the published port.
# Set 0.0.0.0 to open it to the LAN, and TRUST_PROXY_HEADERS=false with it.
# LUMIA_API_BIND=127.0.0.1

# With docker-compose.external-miniflux.yml, also set MINIFLUX_BASE_URL to your own instance and
# these two to an account that exists on it.
# MINIFLUX_BASE_URL=https://miniflux.example.org
MINIFLUX_USERNAME=admin
MINIFLUX_PASSWORD=change-me
MINIFLUX_WEBHOOK_SECRET=change-me

DEEPL_API_KEY=change-me

# JWT_SECRET must not stay at change-me: the API refuses to start with the placeholder, and compose
# refuses to start with a variable left unset.

# Backend logging. json is what a deployed instance wants, console is easier to read while
# developing. The level is a python one: DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
LOG_FORMAT=json
