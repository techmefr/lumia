server {
	listen 8080;
	server_name _;
	root /usr/share/nginx/html;
	index index.html;

	gzip on;
	gzip_types text/css application/javascript application/json image/svg+xml;

	include /etc/nginx/conf.d/security-headers.conf;

	# Same-origin API. The app is opened from a phone or a tablet by the machine's LAN
	# address, so a backend host baked into the bundle would break the moment that address
	# changes. Proxying keeps one single origin and removes CORS from the picture.
	#
	# The upstream is substituted at startup from LUMIA_BACKEND_URL. Only variables prefixed
	# LUMIA_ are substituted (NGINX_ENVSUBST_FILTER), so nginx's own $host and $uri survive.
	location /api/ {
		proxy_pass ${LUMIA_BACKEND_URL}/;
		proxy_set_header Host $host;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;
		# OPML exports run large.
		client_max_body_size 20m;
	}

	# Hashed filenames, so they can never go stale.
	location /_app/immutable/ {
		expires 1y;
		add_header Cache-Control "public, immutable";
		include /etc/nginx/conf.d/security-headers.conf;
		try_files $uri =404;
	}

	# SPA fallback: every route is resolved client-side.
	location / {
		try_files $uri $uri/ /index.html;
	}
}
